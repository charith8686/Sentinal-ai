# Sentinel AI Configuration
SENTINEL_ENV=production
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=8000
SENTINEL_DB_PATH=sentinel_ai.db
SECRET_KEY=change-to-a-secure-random-32-character-secret-in-production

# AI Provider Configuration
# Supported providers: watsonx, openai, anthropic, mock
AI_PROVIDER=watsonx

# IBM watsonx.ai settings (if AI_PROVIDER=watsonx)
WATSONX_APIKEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# OpenAI settings (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# Anthropic settings (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-3-5-sonnet-20241022
